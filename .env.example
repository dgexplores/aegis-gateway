# Copy to .env and fill in. NEVER commit real secrets.

# --- Server ---
AEGIS_ENV=development
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8080

# --- Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
AEGIS_AUDIT_HMAC_KEY=change-me-audit-hmac-key-min-32-chars
AEGIS_VAULT_HMAC_KEY=change-me-vault-hmac-key-min-32-chars

# --- Tenants (format: id:sha256(apikey):scope1+scope2 , comma between tenants) ---
# Demo tenant: use  Authorization: Bearer demo-sk-aegis-2024
# Generate your own: python scripts/gen_tenant.py --id acme --scopes chat+rag
AEGIS_TENANTS=demo:e3e18b6e9c3d49198e61396c5e4439668591ec224bac1ef1c2736661d80763ef:chat+rag

# Pre-filled into the /dashboard key field in DEVELOPMENT ONLY. /dashboard is
# unauthenticated, so a working key there is public; the route never injects
# this when AEGIS_ENV=production. Leave empty in production.
AEGIS_DEMO_API_KEY=demo-sk-aegis-2024

# --- Providers (optional; gateway runs offline with echo provider if unset) ---
AEGIS_PROVIDERS=echo
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GMI_API_KEY=   # from https://console.gmicloud.ai  (OpenAI-compatible: https://api.gmi-serving.com/v1)
# GMI_BASE_URL=https://api.gmi-serving.com/v1
# GMI_MODEL=Qwen/Qwen3.8-27B

# --- Limits (fail-closed defaults) ---
AEGIS_RATE_LIMIT_PER_MIN=60
AEGIS_DAILY_TOKEN_BUDGET=200000
AEGIS_INJECTION_BLOCK_THRESHOLD=0.7
AEGIS_CACHE_TTL_SECONDS=300
# Refuse client-supplied `system` turns with 400. Default true (drop-in
# OpenAI-compatible clients legitimately send one) — set false when the gateway
# owns the system prompt, e.g. RAG-only deployments. This is POLICY, not
# protection: every turn is scanned and PII-redacted regardless of role.
# AEGIS_ALLOW_CLIENT_SYSTEM_PROMPT=true

# --- Persistence / infra (empty = memory mode, works with no services) ---
AEGIS_AUDIT_PATH=audit.jsonl
AEGIS_AUDIT_MAX_BYTES=10000000
# AEGIS_REDIS_URL=redis://localhost:6379/0
# AEGIS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Phase-2/3 tracks (all optional, safe defaults) ---
# Per-tenant model allowlist: "acme:echo-economy+echo-premium;other:gpt-4o-mini"
# AEGIS_TENANT_MODELS=
# Encrypted audit payload copies (any string; Fernet when `cryptography` installed)
# AEGIS_AUDIT_ENCRYPT_KEY=
# S3 archive of rotated audit files (needs boto3 + credentials)
# AEGIS_AUDIT_S3_BUCKET=
# AEGIS_AUDIT_S3_PREFIX=aegis-audit/
# Embeddings: legacy (default, zero-dep) | hash | gmi | openai
# AEGIS_EMBED_PROVIDER=legacy
# AEGIS_EMBED_MODEL=
