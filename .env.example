# Copy to .env and fill in. NEVER commit real secrets.

# --- Server ---
AEGIS_ENV=development
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8080

# --- Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
AEGIS_AUDIT_HMAC_KEY=change-me-audit-hmac-key-min-32-chars
AEGIS_VAULT_HMAC_KEY=change-me-vault-hmac-key-min-32-chars

# --- Tenants (format: id:sha256(apikey):scope1+scope2 , comma between tenants) ---
# Demo tenant: use  Authorization: Bearer demo-sk-aegis-2024
# Generate your own: python scripts/gen_tenant.py --id acme --scopes chat+rag
AEGIS_TENANTS=demo:e3e18b6e9c3d49198e61396c5e4439668591ec224bac1ef1c2736661d80763ef:chat+rag

# --- Providers (optional; gateway runs offline with echo provider if unset) ---
AEGIS_PROVIDERS=echo
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GMI_API_KEY=   # from https://console.gmicloud.ai  (OpenAI-compatible: https://api.gmi-serving.com/v1)
# GMI_BASE_URL=https://api.gmi-serving.com/v1
# GMI_MODEL=Qwen/Qwen3.8-27B

# --- Limits (fail-closed defaults) ---
AEGIS_RATE_LIMIT_PER_MIN=60
AEGIS_DAILY_TOKEN_BUDGET=200000
AEGIS_INJECTION_BLOCK_THRESHOLD=0.7
AEGIS_MAX_INPUT_TOKENS=8000
AEGIS_CACHE_TTL_SECONDS=300
